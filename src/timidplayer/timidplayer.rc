    CONTROL         "Spin1",IDC_DEFPROGS,"msctls_updown32",UDS_SETBUDDYINT|UDS_ALIGNRIGHT|UDS_AUTOBUDDY|UDS_ARROWKEYS,200,122,10,15
    PUSHBUTTON      "Set Dr&um Channels...",IDC_DRUMCHANNELS,10,138,90,15,WS_TABSTOP
    PUSHBUTTON      "Set &Quiet Channels...",IDC_QUIETCHANNELS,110,138,90,15,WS_TABSTOP
    AUTOCHECKBOX    "Enable &Reverb",IDC_REVERBENABLED,10,154,130,10,WS_TABSTOP
    AUTOCHECKBOX    "Onl&y Output Reverb",IDC_REVERBONLY,150,154,130,10,WS_TABSTOP
    LTEXT           "Reverb &Level:",IDC_STATIC,10,170,90,8
    CONTROL         "Slider1",IDC_REVERBLEVEL,"msctls_trackbar32",WS_TABSTOP,110,170,100,18
    LTEXT           "Reverb &Preset:",IDC_STATIC,10,194,90,8
    COMBOBOX        IDC_REVERBPRESET,110,192,70,10,WS_TABSTOP|WS_VSCROLL|CBS_DROPDOWNLIST
