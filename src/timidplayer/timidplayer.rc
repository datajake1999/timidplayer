IDD_BATCH DIALOG DISCARDABLE  0, 0, 400, 348
CAPTION "Batch Convert MIDI to WAV"
STYLE DS_MODALFRAME|DS_SETFONT|DS_SETFOREGROUND|WS_CAPTION|WS_POPUP|WS_SYSMENU|WS_MINIMIZEBOX
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "&MIDI Files:",IDC_STATIC,10,8,150,8
    CONTROL         "",IDC_FILELIST,"SysListView32",LVS_REPORT|LVS_NOCOLUMNHEADER|LVS_SHOWSELALWAYS|WS_VSCROLL|WS_TABSTOP|WS_BORDER,10,20,225,150
    PUSHBUTTON      "&Add Files...",IDC_ADDFILES,245,20,70,15,WS_TABSTOP
    PUSHBUTTON      "Add F&older...",IDC_ADDFOLDER,320,20,70,15,WS_TABSTOP
    PUSHBUTTON      "&Remove",IDC_REMOVE,245,40,70,15,WS_TABSTOP
    PUSHBUTTON      "C&lear All",IDC_CLEARALL,320,40,70,15,WS_TABSTOP
    PUSHBUTTON      "Move &Up",IDC_MOVEUP,245,60,70,15,WS_TABSTOP
    PUSHBUTTON      "Move &Down",IDC_MOVEDOWN,320,60,70,15,WS_TABSTOP
    LTEXT           "Output &Folder (blank = same as source file):",IDC_STATIC,10,178,300,8
    EDITTEXT        IDC_OUTDIR,10,190,300,12,WS_TABSTOP|ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...",IDC_OUTDIRB,320,190,70,15,WS_TABSTOP
    PUSHBUTTON      "Sa&ve as Default",IDC_OUTDIRDEFAULT,10,206,120,15,WS_TABSTOP
    AUTOCHECKBOX    "Over&write Existing Files",IDC_OVERWRITE,10,224,140,10,WS_TABSTOP
    AUTOCHECKBOX    "&Preserve Folder Structure",IDC_PRESERVEDIRS,155,224,225,10,WS_TABSTOP
    LTEXT           "Output Forma&t:",IDC_STATIC,10,242,60,8
    COMBOBOX        IDC_OUTFORMAT,73,240,112,100,CBS_DROPDOWNLIST|WS_VSCROLL|WS_TABSTOP
    CONTROL         "",IDC_PROGRESS,"msctls_progress32",WS_BORDER,10,260,380,12
    LTEXT           "",IDC_STATUS,10,275,380,10,SS_NOPREFIX|SS_LEFTNOWORDWRAP
    DEFPUSHBUTTON   "&Convert",IDC_CONVERT,10,300,80,17,WS_TABSTOP
    PUSHBUTTON      "Save C&SV...",IDC_SAVECSV,100,300,80,17,WS_TABSTOP
    PUSHBUTTON      "Close",IDCANCEL,310,323,80,17,WS_TABSTOP
END

