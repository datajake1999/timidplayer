    EDITTEXT        IDC_AMP,310,42,80,12,WS_TABSTOP|ES_AUTOHSCROLL|ES_NUMBER
    CONTROL         "Spin1",IDC_AMPS,"msctls_updown32",UDS_SETBUDDYINT|UDS_ALIGNRIGHT|UDS_AUTOBUDDY|UDS_ARROWKEYS,400,42,10,15
    AUTOCHECKBOX    "Ad&just Panning Immediately",IDC_PAN,10,58,130,10,WS_TABSTOP
    AUTOCHECKBOX    "Mono &Output",IDC_MONO,150,58,130,10,WS_TABSTOP
    AUTOCHECKBOX    "Render &8-Bit Samples",IDC_8BIT,290,58,130,10,WS_TABSTOP
    AUTOCHECKBOX    "A&ntialiasing",IDC_ANTI,10,74,130,10,WS_TABSTOP
    AUTOCHECKBOX    "Pr&eResample",IDC_PRERES,150,74,130,10,WS_TABSTOP
    AUTOCHECKBOX    "&Fast Decay",IDC_FASTDEC,10,90,130,10,WS_TABSTOP
    AUTOCHECKBOX    "&Dynamically Load Instruments",IDC_DYNALOAD,150,90,130,10,WS_TABSTOP
    LTEXT           "Default &Instrument:",IDC_STATIC,10,106,90,8
    EDITTEXT        IDC_DEFINST,110,106,160,12,WS_TABSTOP|ES_AUTOHSCROLL
    PUSHBUTTON      "Bro&wse...",IDC_DEFINSTB,280,106,90,15,WS_TABSTOP
    LTEXT           "Default Pro&gram:",IDC_STATIC,10,122,90,8
